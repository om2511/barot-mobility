PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-string-at-least-32-characters-long
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password-at-least-8-characters-long
ADMIN_EMAIL=your-admin-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-account@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=your-smtp-account@example.com
CLIENT_ORIGIN=http://localhost:5173
